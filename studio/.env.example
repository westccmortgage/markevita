# ─────────────────────────────────────────────────────────────────────────────
# MarkeVita AI Series Studio — backend environment contract.
# Secrets live ONLY here. They are never sent to the browser and never stored
# in Supabase. The Integrations page reports presence, never values.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Studio runtime ----
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8800
# Public path prefix when a CDN proxies a sub-path to this service.
# Empty for local use; "/studio" when served as markevita.com/studio.
STUDIO_BASE_PATH=
# Signs the admin session cookie. Generate: python -c "import secrets;print(secrets.token_hex(32))"
STUDIO_SESSION_SECRET=

# HARD SAFETY SWITCH. Must stay false. The studio refuses every paid provider
# call while this is false, regardless of what the admin panel requests.
STUDIO_ALLOW_PAID=false

# Connection tests are offline by default: credential presence and shape only,
# no outbound request. Leave false to guarantee zero provider traffic.
STUDIO_ALLOW_CONNECTION_TESTS=false

# Storage driver for studio records: supabase | local
# "local" keeps everything in .studio-data/*.json so the panel opens with no
# cloud setup. "supabase" is the production driver.
STUDIO_STORE=local

# Admin sign-in for the local driver (Supabase Auth is used when configured).
STUDIO_ADMIN_EMAIL=
STUDIO_ADMIN_PASSWORD=

# ---- Supabase (auth + records) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (direction, vision QC) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- OpenAI (reserved: alternate director/QC model) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---- fal.ai (images, video, lipsync) ----
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/nano-banana-2/edit
FAL_VIDEO_MODEL=fal-ai/veo3.1/fast/image-to-video
FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v2

# ---- ElevenLabs (voice). One voice id per character; the variable NAME is
# declared per character in the series bible as voice.voice_env. ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
# ELEVENLABS_VOICE_ID_<CHARACTER_ID_UPPER>=

# ---- Cloudflare R2 (all media) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_S3_ENDPOINT=
R2_PUBLIC_BASE_URL=

# ---- Production caps (a series package may lower these, never raise them) ----
MAX_EPISODE_BUDGET_USD=50
MAX_SCENE_REGENERATIONS=2
MAX_CLIP_SECONDS=10

# ---- Publishing: disabled ----
INSTAGRAM_PUBLISH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
