# ---- Режим ----
# Платные вызовы делаются ТОЛЬКО с флагом --live И PIPELINE_ALLOW_PAID=true И series.json approval.status=approved
PIPELINE_ALLOW_PAID=false

# ---- LLM (direction при отсутствии production_prompts.json, vision-QC) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- fal.ai (картинки, видео, lipsync) ----
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/veo3.1/fast/image-to-video
FAL_IMAGE_MODEL=fal-ai/nano-banana-2/edit
FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v2
LIPSYNC_VARIANT=lipsync-2
VIDEO_RESOLUTION=1080p
VIDEO_GENERATE_AUDIO=false
VIDEO_AUTO_FIX=false
IMAGE_RESOLUTION=1K
# r2_presigned (spec §4) | fal_storage (без R2, файлы уходят в fal storage)
PROVIDER_INPUT_MODE=r2_presigned

# ---- ElevenLabs. Один voice id на персонажа; имя переменной задаётся в bible/characters.json -> voice.voice_env ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
# ELEVENLABS_VOICE_ID_<CHAR_ID_UPPER>=

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_S3_ENDPOINT=
R2_PUBLIC_BASE_URL=

# ---- Лимиты (потолки; пакет может только понизить) ----
MAX_EPISODE_BUDGET_USD=50
MAX_SCENE_REGENERATIONS=2
MAX_CLIP_SECONDS=10

# ---- Публикация (выключено) ----
INSTAGRAM_PUBLISH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ---- Зарезервировано для worker/webhook версии (не используется локальным скриптом) ----
FAL_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=
PIPELINE_WEBHOOK_BASE_URL=
PIPELINE_WEBHOOK_SECRET=
